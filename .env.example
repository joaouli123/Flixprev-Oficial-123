# Configuracoes do Supabase
# Copie este arquivo para .env e preencha com suas credenciais reais
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_BASE_URL=https://flixprev-oficial-123-production.up.railway.app

# Banco de dados PostgreSQL (Neon/Supabase Postgres)
# Necessario para historico persistente, isolamento por usuario e RAG vetorial completo
DATABASE_URL=postgresql://user:password@host:5432/database

# Chat principal: Claude
ANTHROPIC_API_KEY=your_anthropic_key_here
CHAT_MODEL=claude-sonnet-4-6
FAST_CHAT_MODEL=claude-sonnet-4-6

# Embeddings: manter separado do chat
# Recomendado: OpenAI text-embedding-3-large
OPENAI_API_KEY=your_openai_key_here
EMBEDDING_MODEL=text-embedding-3-large

# Alternativa de embeddings com Gemini (OpenAI-compatible endpoint)
# GEMINI_API_KEY=your_gemini_key_here
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Overrides opcionais se quiser separar ainda mais os provedores
# CHAT_API_KEY=
# CHAT_BASE_URL=
# EMBEDDING_API_KEY=
# AI_EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# Desabilitado por padrao para priorizar respostas estritamente ancoradas no RAG
ENABLE_DIRECT_PDF_ANALYSIS=false

# Ajustes de busca profunda no RAG
RAG_VECTOR_LIMIT=64
RAG_RETURN_LIMIT=24
RAG_MIN_SIMILARITY=0.12
RAG_KEYWORD_LIMIT=12
CHAT_MAX_TOKENS=3200
FAST_CHAT_MAX_TOKENS=2200

# Dominios permitidos para CORS (separados por virgula)
# Exemplo: http://localhost:8080,https://flixprev.com
VITE_ALLOWED_ORIGINS=http://localhost:8080
