APP_NAME=Surgical RAG Agent
ENVIRONMENT=development
LOG_LEVEL=INFO

PYTHON_AGENT_DATABASE_URL=sqlite:///./agent.db

QDRANT_URL=https://a3415aa3-7d83-4675-a45c-c6f60e8d4c44.us-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=replace_with_your_qdrant_api_key
